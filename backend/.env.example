# Veg Vibe Backend Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================================================
# USDA FoodData Central API
# ============================================================================
# Purpose: Provides authoritative nutritional data for ingredient grounding
# 
# Get your free API key at: https://fdc.nal.usda.gov/
# Steps:
#   1. Visit https://fdc.nal.usda.gov/
#   2. Sign up for a free account
#   3. Navigate to your account settings
#   4. Generate an API key
# 
# Rate limit: Free tier allows ~2000 requests per hour
# Documentation: https://fdc.nal.usda.gov/api-guide
#
USDA_API_KEY=your_usda_api_key_here

# ============================================================================
# Open Food Facts API
# ============================================================================
# Purpose: Verifies if branded products are vegan (Open API - no key needed)
# 
# This is community-maintained and open-source!
# No API key required, but requests are rate-limited
# 
# Rate limit: ~10 requests per second (rate-limited for fairness)
# Documentation: https://world.openfoodfacts.org/api
# 
# NOTE: The app has built-in retry logic with exponential backoff
# to handle rate limits gracefully
#
# (No configuration needed - service is available without credentials)

# ============================================================================
# PETA Animal-Derived Ingredients List
# ============================================================================
# Purpose: Hard-coded filter against PETA-aligned non-vegan ingredients
# 
# The app includes an embedded list of animal-derived ingredients from:
#   https://www.peta.org/living/food/animal-derived-ingredients/
# 
# This list includes: dairy, eggs, meat, honey, gelatin, etc.
# Every recipe ingredient is checked against this list before recommendation
#
# (No configuration needed - list is built into data_fetcher.py)

# ============================================================================
# HuggingFace Datasets Configuration (optional, for setup_verified_data.py)
# ============================================================================
# Purpose: Download high-quality recipe datasets with nutrition info
# 
# If you want to regenerate the verified dataset, you may need HF credentials
# For public datasets like datahiveai/recipes-with-nutrition, no key is required
#
# Get your HF token at: https://huggingface.co/settings/tokens
#
# HF_TOKEN=your_huggingface_token_here

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Feature Flags
# ============================================================================
# Enable/disable verification for testing
ENABLE_VERIFICATION=true

# Minimum confidence score required to recommend a recipe (0.0 - 1.0)
MIN_VERIFICATION_CONFIDENCE=0.7

# Require external verification before returning any recipe
STRICT_VERIFICATION_MODE=false
